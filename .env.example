DEBUG=False
SECRET_KEY=change-me-to-a-random-secret
DJANGO_SETTINGS_MODULE=zigma_core.settings.prod
ALLOWED_HOSTS=.zigma.io,localhost
CORS_ALLOWED_ORIGINS=https://app.zigma.io,https://admin.zigma.io
CSRF_TRUSTED_ORIGINS=https://app.zigma.io,https://admin.zigma.io

# Database (Supabase PostgreSQL)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
USE_LOCAL_DB=False
DB_CONN_MAX_AGE=60

# Redis (Celery broker + cache)
CELERY_BROKER_URL=redis://:password@your-redis-cluster:6379/0
REDIS_CACHE_URL=redis://:password@your-redis-cluster:6379/1

# Alpaca Markets
APCA_API_KEY_ID=your-alpaca-api-key
APCA_API_SECRET_KEY=your-alpaca-secret-key
APCA_BASE_URL=https://paper-api.alpaca.markets

# AI
GEMINI_API_KEY=your-gemini-api-key

# Monitoring
SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# Gunicorn (optional overrides)
GUNICORN_WORKERS=8
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
